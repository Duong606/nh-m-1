#include<iostream>
using namespace std;

typedef struct canho
{
	string mach;
	string toanha;
	int tang;
	double dientich;
	int sophong;
	double gia;
	bool daban; 
}ch;

class mang
{
	private:
		int stn;
		ch a[200];
	public:
		void nhap();
		void nhapch(ch &x);
		void xuat();
		void xuatch(ch &x);
		void sapxep();				//sap xep theo dien tich tang dan
		int timkiem(string l);		//tim kiem theo ma can ho
		void timkiemtt(bool daban); 	//in cac van ban trang thai 
		void chen(int k);		
		void xoa(int c);
};

void mang::nhapch(ch &x)
{
	cout<<"Nhap ma can ho: "; cin>>x.mach;
	cout<<"Nhap toa nha: "; cin>>x.toanha;
	cout<<"Nhap so tang: "; cin>>x.tang;
	cout<<"Nhap dien tich: "; cin>>x.dientich;
	cout<<"Nhap so phong ngu: "; cin>>x.sophong;
	cout<<"Nhap gia ban: "; cin>>x.gia;
	
	int tt;
	do
	{
		cout<<"Tinh trang (1: da ban, 0: chua ban): ";
		cin>>tt;
	} while(tt != 0 && tt != 1);
	x.daban = (tt == 1);
}
void mang::nhap()
{
	do
	{
		cout<<"Nhap so toa: "; cin>>stn;
	}while(stn<=0 || stn>200);
	for(int i=0;i<stn;i++)
	{
		cout<<"Nhap can ho "<<i+1<<": "<<endl;
		nhapch(a[i]); 
	}
}

void mang::xuatch(ch &x)
{
	cout<<"Ma can ho: "<<x.mach<<endl;
	cout<<"Toa nha: "<<x.toanha<<endl;
	cout<<"So tang: "<<x.tang<<endl;
	cout<<"Dien tich: "<<x.dientich<<" m2"<<endl;
	cout<<"So phong ngu: "<<x.sophong<<endl;
	cout<<"Gia ban: "<<x.gia<<" trieu"<<endl;
	cout<<"Tinh trang: "<<(x.daban ? "Da ban" : "Chua ban")<<endl;
}

void mang::xuat()
{
	for(int i=0;i<stn;i++)
	{
		cout<<"--------------------------"<<endl;
		cout<<"Toa so "<<i+1<<": "<<endl;
		xuatch(a[i]);
	}
}

void mang::sapxep()
{
	for(int i=0;i<stn;i++)
	{
		for(int j=i;j<stn;j++)
		{
			if(a[i].dientich>a[j].dientich)
			{
				int temp = a[i].dientich;
				a[i].dientich = a[j].dientich;
				a[j].dientich = temp;
			}
		}
	}
 }

int mang::timkiem(string ma)
{
	for(int i=0;i<stn;i++)
	{
		if(a[i].mach == ma)
		return i;
	 }
	 return -1;
}

void mang::timkiemtt(bool daban)
{
	bool thay=false;
	for(int i=0;i<stn;i++)
	{
		if(a[i].daban == daban)
		{
			cout<<"-----"<<endl;
			xuatch(a[i]);
			
			thay = true;
		}
	}
	if(!thay)
		cout<<"Khong tim thay"<<endl;
}

void mang::chen(int k)
{
	if(stn>=200 || k<1 || k>stn+1)
	{
		cout<<"Khong chen duoc!"<<endl;
		return;
	}
	for(int i=stn;i>k-1;i--)
	{
		a[i]=a[i-1];
	}
	nhapch(a[k-1]);
	stn++;
} 

void mang::xoa(int c)
{
	if(c>200 || c<1)
	{
		cout<<"Khong xoa duoc!";
		return;
	}
	for(int i=c-1;i<stn-1;i++)
	{
		a[i]=a[i+1];
	}
	stn--;
}
int main()
{
	ch a[200];		//day la can ho
	mang m;			//day la so luong 
	int chon,c,k;	// chon option tim kiem, c la vi tri muon xoa; k la vi tri muon chen
	string ma;
	m.nhap(); m.xuat();
	
	m.sapxep();
	cout<<endl<<"Ta co dien tich tang dan:"<<endl;
	m.xuat();
	
	cout<<"Chon theo cach (1: Ma can ho || 2: Tinh trang ban): ";
	cin>>chon;
	
	if(chon==1)
	{
	cout<<"Nhap ma can ho muon tim: ";
	cin>>ma;
	int vt=m.timkiem(ma);
	if(vt==-1)
		cout<<"Khong tim thay!";
	else
		m.xuatch(a[vt]);
	}
	if(chon==2)
	{
		int tt;
		cout<<"Chon trang thai (1: Da ban || 0: Chua ban): ";
		cin>>tt;
		m.timkiemtt(tt == 1);
	}
	
	cout<<"Nhap vi tri muon chen: "; cin>>k;
	m.chen(k);
	cout<<"Mang sau chen:"<<endl;
	m.xuat();
	
	cout<<"Nhap vi tri muon xoa: "; cin>>c;
	m.xoa(c);
	cout<<"Mang sau xoa:"<<endl;
	m.xuat();
	
	return 0;
 } 
